// The window's look: Windows 11 light or dark, in the Windows accent colour, or Classic (plain
// Windows colours, also used for high contrast). theme.rs reads Windows' settings and fills this in.
import { Palette } from "std-widgets.slint";

export global Theme {
    // "light", "dark" or "classic"
    in-out property <string> mode: "light";
    in-out property <color> accent: #005fb8;
    // Text on the accent colour
    in-out property <color> on-accent: #ffffff;
    // Windows' "Make text bigger" (1.0 to 2.25)
    in-out property <float> text-scale: 1.0;
    // Classic colours, from Windows (high contrast colours when that is on)
    in-out property <color> classic-window: #ffffff;
    in-out property <color> classic-text: #000000;
    in-out property <color> classic-face: #f0f0f0;
    in-out property <color> classic-shadow: #a0a0a0;
    in-out property <color> classic-gray-text: #6d6d6d;

    out property <bool> dark: mode == "dark";
    out property <bool> classic: mode == "classic";
    out property <color> window-bg: classic ? classic-face : dark ? #202020 : #f3f3f3;
    out property <color> card: classic ? classic-window : dark ? #2b2b2b : #fbfbfb;
    out property <color> card-hover: classic ? classic-window : dark ? #323232 : #f5f5f5;
    out property <color> card-border: classic ? classic-shadow : dark ? #1d1d1d : #e5e5e5;
    out property <color> control: classic ? classic-window : dark ? #373737 : #ffffff;
    out property <color> control-hover: classic ? classic-face : dark ? #3c3c3c : #f9f9f9;
    out property <color> control-border: classic ? classic-shadow : dark ? #454545 : #d0d0d0;
    out property <color> text: classic ? classic-text : dark ? #ffffff : #1b1b1b;
    out property <color> text2: classic ? classic-gray-text : dark ? #c5c5c5 : #5f5f5f;
    out property <color> text3: classic ? classic-gray-text : dark ? #9a9a9a : #8a8a8a;
    out property <color> hover: classic ? #00000010 : dark ? #ffffff0f : #0000000a;
    out property <color> selected: classic ? #00000018 : dark ? #ffffff15 : #0000000f;
    out property <color> ok: dark ? #6ccb5f : #0f7b0f;
    out property <color> warn: dark ? #fce100 : #9d5d00;
    out property <color> error: dark ? #ff99a4 : #c42b1c;
    out property <color> led-off: dark ? #3a3a3a : #d6d6d6;
    out property <length> radius: classic ? 0px : 6px;
    out property <length> small-radius: classic ? 0px : 4px;

    out property <length> caption: 12px * text-scale;
    out property <length> body: 14px * text-scale;
    out property <length> body-large: 18px * text-scale;
    out property <length> subtitle: 20px * text-scale;
    out property <length> title: 28px * text-scale;
}

// Keeps Slint's own controls (combo boxes, text boxes, buttons) light or dark with the window
export component ThemeSync {
    init => { self.sync(); }
    changed dark => { self.sync(); }
    property <bool> dark: Theme.dark;
    function sync() {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
}
