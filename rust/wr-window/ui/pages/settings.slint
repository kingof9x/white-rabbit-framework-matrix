// Settings: the app's own settings, and the pages used less often.
import { App } from "../state.slint";
import { Card, SectionTitle, Button, AccentButton, Status } from "../widgets.slint";
import { ComboBox } from "std-widgets.slint";
import { Kb } from "../keyboard/state.slint";

// Check for updates: a newer White Rabbit and newer panel firmware. Only when the user clicks.
export global UpdatesPage {
    in property <bool> checking;
    in property <string> app-status;
    in property <bool> can-install;
    in property <bool> show-page;
    in property <string> firmware-status;
    in property <bool> can-flash;
    in property <string> flash-label;
    callback check();
    callback install();
    callback release-page();
    callback flash();
}

export component SettingsPage inherits VerticalLayout {
    spacing: 4px;
    SectionTitle { text: "Appearance"; }
    Card {
        icon: @image-url("../icons/dark_theme.svg");
        title: "App theme";
        help: "Follows Windows' light or dark mode and accent colour. Classic is the plain Windows look White Rabbit used to have; Windows high contrast always uses it.";
        ComboBox {
            width: 230px;
            model: ["Use my Windows setting", "Light", "Dark", "Classic"];
            current-index: App.theme-choice;
            selected => {
                App.theme-choice = self.current-index;
                App.theme-chosen(self.current-index);
            }
        }
    }
    Rectangle { height: 14px; }
    SectionTitle { text: "Panels"; }
    if App.panels.length == 0: Card {
        icon: @image-url("../icons/grid.svg");
        title: "No LED Matrix panels found";
        help: "Check that the panels are in place, then open White Rabbit again.";
    }
    for panel in App.panels: Card {
        icon: @image-url("../icons/grid.svg");
        title: panel.label;
        help: panel.doing;
    }
    Card {
        icon: @image-url("../icons/rename.svg");
        title: "Panel names";
        help: "Give the left and right panels names of your own.";
        Button { text: "Name panels..."; clicked => { App.name-panels(); } }
    }
    Card {
        icon: @image-url("../icons/target_arrow.svg");
        title: "Identify panels";
        help: "Shows each panel's name on it, so you know which is which.";
        Button { text: "Identify"; clicked => { App.identify(); } }
    }
    if App.home-status != "": Status { text: App.home-status; }
    Card { link: true; icon: @image-url("../icons/developer_board.svg"); title: "Firmware";
        help: "See the firmware on each panel, keyboard and macropad, and install new firmware."; clicked => { App.page = "firmware"; } }
    if Kb.kb-present || Kb.mod-present: Card { link: true; icon: @image-url("../icons/keyboard.svg"); title: "Keyboard & macropad";
        help: "Which keyboard you have (clear or black keys) and which side the macropad or numpad is on."; clicked => { App.page = "kbsetup"; } }
    Rectangle { height: 14px; }
    SectionTitle { text: "Updates"; }
    Card {
        icon: @image-url("../icons/arrow_sync.svg");
        title: "Check for updates";
        help: "Looks on GitHub for a newer White Rabbit and newer panel firmware. White Rabbit only checks when you click here.";
        Button { text: "Check for updates"; enabled: !UpdatesPage.checking; clicked => { UpdatesPage.check(); } }
    }
    if UpdatesPage.app-status != "": Card {
        icon: @image-url("../icons/app.png");
        title: "White Rabbit";
        help: UpdatesPage.app-status;
        HorizontalLayout {
            spacing: 8px;
            if UpdatesPage.show-page: Button { text: "Download page"; clicked => { UpdatesPage.release-page(); } }
            if UpdatesPage.can-install: AccentButton { text: "Download and install"; enabled: !UpdatesPage.checking; clicked => { UpdatesPage.install(); } }
        }
    }
    if UpdatesPage.firmware-status != "": Card {
        icon: @image-url("../icons/developer_board.svg");
        title: "Panel firmware";
        help: UpdatesPage.firmware-status;
        if UpdatesPage.can-flash: AccentButton { text: UpdatesPage.flash-label; enabled: !UpdatesPage.checking; clicked => { UpdatesPage.flash(); } }
    }
    Rectangle { height: 14px; }
    SectionTitle { text: "App"; }
    Card { link: true; icon: @image-url("../icons/keyboard.svg"); title: "Keyboard shortcuts";
        help: "Shortcuts that work anywhere in Windows."; clicked => { App.page = "shortcuts"; } }
    Card { link: true; icon: @image-url("../icons/info.svg"); title: "About White Rabbit";
        help: "Version, credits and the tip jar."; clicked => { App.page = "about"; } }
}
