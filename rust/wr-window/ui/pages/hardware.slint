// Home: the hardware White Rabbit found, as a picture of the laptop's input deck (the keyboard picture
// from the keyboard pages, with the LED panels in their slots) and a list in the order it was found.
// hardware.rs fills it in.
import { Theme } from "../theme.slint";
import { Group, Icon, LedImage } from "../widgets.slint";
import { Kb } from "../keyboard/state.slint";
import { Deck } from "../keyboard/parts.slint";

export struct HwRow { order: string, name: string, detail: string, status: string, ok: bool, kind: string }

export global Hardware {
    in property <[HwRow]> rows;
    // One LED panel, drawn with its LEDs off
    in property <image> panel;
    // What is plugged in, and each one's number in the list ("" = not found)
    in property <string> left-panel;
    in property <string> right-panel;
    in property <string> keyboard;
    in property <string> module;
}

component Badge inherits Rectangle {
    in property <string> text;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: Theme.accent;
    border-width: 2px;
    border-color: #ffffff;
    Text { text: root.text; color: Theme.on-accent; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
}

// An LED panel on its own (when it isn't drawn in the keyboard picture's slot)
component Panel inherits VerticalLayout {
    in property <string> badge;
    // The keyboard picture's width beside it, so the panel is drawn to the same scale
    in property <length> deck-width: 760px;
    alignment: start;
    padding-top: deck-width * 0.0118;
    Rectangle {
        width: deck-width * 0.0842;
        height: deck-width * 0.3066;
        LedImage { source: Hardware.panel; width: parent.width; height: parent.height; image-fit: fill; }
        if badge != "": Badge { text: badge; x: (parent.width - self.width) / 2; y: -11px; }
    }
}

// The keyboard picture with the LED panels in the slots beside the keyboard. The slots' places are
// fractions of the picture's width, like the key legends.
component DeckPicture inherits Rectangle {
    height: deck.height;
    deck := Deck { width: parent.width; }
    property <length> w: self.width;
    // With no macropad or numpad the keyboard is in the middle and the slots are the LED panels' places
    property <bool> slots: Kb.side == 0;
    if slots && Hardware.left-panel != "": LedImage {
        source: Hardware.panel; image-fit: fill;
        x: w * 0.0118; y: w * 0.0118; width: w * 0.0842; height: w * 0.3066;
    }
    if slots && Hardware.right-panel != "": LedImage {
        source: Hardware.panel; image-fit: fill;
        x: w * 0.8908; y: w * 0.0118; width: w * 0.0842; height: w * 0.3066;
    }
    if slots && Hardware.left-panel != "": Badge { text: Hardware.left-panel; x: w * 0.0539 - 11px; y: -6px; }
    if slots && Hardware.right-panel != "": Badge { text: Hardware.right-panel; x: w * 0.9329 - 11px; y: -6px; }
    if Hardware.keyboard != "": Badge {
        text: Hardware.keyboard;
        x: (Kb.side == 0 ? w * 0.5 : Kb.module-left ? w * 0.6 : w * 0.4) - 11px;
        y: -6px;
    }
    if Hardware.module != "": Badge { text: Hardware.module; x: (Kb.module-left ? w * 0.1 : w * 0.9) - 11px; y: -6px; }
}

component Row inherits Rectangle {
    in property <HwRow> item;
    height: 44px;
    HorizontalLayout {
        spacing: 12px;
        padding-left: 4px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px; height: 24px; border-radius: 12px;
                background: Theme.accent;
                Text { text: item.order; color: Theme.on-accent; font-size: 12px; font-weight: 700;
                    horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                source: item.kind == "keyboard" ? @image-url("../icons/keyboard.svg") : item.kind == "macropad" ? @image-url("../icons/grid.svg")
                    : @image-url("../icons/developer_board.svg");
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: item.name; color: Theme.text; font-size: Theme.body; }
            if item.detail != "": Text { text: item.detail; color: Theme.text2; font-size: Theme.caption; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            Text { text: item.status; color: item.ok ? Theme.ok : Theme.warn; font-size: Theme.caption; horizontal-alignment: right; }
        }
    }
}

export component HardwareArea inherits Group {
    title: "Your hardware";
    help: Hardware.rows.length == 0
        ? "No LED Matrix panels, keyboard or macropad found yet. Plug one in and it shows up here straight away."
        : "What White Rabbit found, numbered in the order it was found. Plug something in or out and it shows up here straight away.";
    spacing: 10px;
    if Hardware.keyboard != "": HorizontalLayout {
        alignment: center;
        padding-top: 12px;
        spacing: 12px;
        if Kb.side != 0 && Hardware.left-panel != "": Panel { badge: Hardware.left-panel; deck-width: 600px; }
        if Kb.side != 0 && (Hardware.left-panel != "" || Hardware.right-panel != ""): DeckPicture { width: 600px; }
        if Kb.side == 0 || (Hardware.left-panel == "" && Hardware.right-panel == ""): DeckPicture { max-width: 760px; horizontal-stretch: 1; }
        if Kb.side != 0 && Hardware.right-panel != "": Panel { badge: Hardware.right-panel; deck-width: 600px; }
    }
    if Hardware.keyboard == "" && (Hardware.left-panel != "" || Hardware.right-panel != ""): HorizontalLayout {
        alignment: center;
        padding-top: 12px;
        spacing: 24px;
        if Hardware.left-panel != "": Panel { badge: Hardware.left-panel; }
        if Hardware.left-panel != "" && Hardware.right-panel != "": Rectangle { width: 400px; }
        if Hardware.right-panel != "": Panel { badge: Hardware.right-panel; }
    }
    for r in Hardware.rows: Row { item: r; }
}
